{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "lib": ["es2020", "dom"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "removeComments": false,
    "noImplicitAny": true,
    "strictNullChecks": true
  },
  "include": [
    "_lib/**/*",
    "actions/**/*",
    "events/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
